<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="crash_prefs.xml"/>
        <include domain="file" path="."/>
        <exclude domain="file" path="crash_reports"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="crash_prefs.xml"/>
        <include domain="file" path="."/>
        <exclude domain="file" path="crash_reports"/>
    </device-transfer>
</data-extraction-rules>
